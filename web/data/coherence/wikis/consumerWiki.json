          "sourceTitle": "Claim using a warranty or guarantee - Citizens Advice"
        },
        {
          "id": "complain",
          "label": "Put a written complaint to the trader or dealer",
          "detail": "Use an open template letter: state the fault, what you want (repair, replace, or refund), and a clear deadline.",
          "sourceUrl": "https://www.citizensadvice.org.uk/consumer/template-letters/letters/consumer-template-letters/",
