# Copy to `.env.local` for local dev (Next.js loads it automatically).
# `npm run sra:sync`, `npm run listings:sync-typesense`, and `npm run db:migrate` also load `.env` then `.env.local` from `web/`.
# Never commit real keys.

# --- Public site links (footer) ---
# NEXT_PUBLIC_SITE_URL=https://www.legalshaman.com
# NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@LegalShaman
# NEXT_PUBLIC_TRUSTPILOT_URL=https://www.trustpilot.com/review/www.legalshaman.com

# =============================================================================
# Legal Shaman lawyer matcher (REQUIRED for /find-a-lawyer + /api/search POST)
# =============================================================================

# --- Postgres (dual-DB split) ---
# Neon Free = accounts only. Home Postgres = SRA / knowledge / embeddings.
# See docs/ops/dual-database-split.md
#
# Home data DB (Podman):
#   cd ../infra/home && ./podman-postgres-data.sh
# Or docker:
#   docker run -d --name pg-legal -e POSTGRES_PASSWORD=postgres -p 5432:5432 \
#     pgvector/pgvector:pg16
#
# ACCOUNTS_DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require
# DATA_DATABASE_URL=postgresql://legalshaman:legalshaman@127.0.0.1:5433/legal_shaman_data
# Legacy single-DB: set only DATABASE_URL (used as fallback for both).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_shaman
# ACCOUNTS_DATABASE_URL=
# DATA_DATABASE_URL=

# --- LLM (OpenAI-compatible; OpenRouter recommended) ---
# For OpenRouter (used by Find a Lawyer, Ask the Shaman, Reddit search):
#   LLM_API_KEY=sk-or-...
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_SMALL_MODEL=openai/gpt-4o-mini
# Without OpenRouter credits, use a free model or LLM_FREE_MODEL fallback:
#   LLM_SMALL_MODEL=google/gemma-4-26b-a4b-it:free
#   LLM_FREE_MODEL=google/gemma-4-26b-a4b-it:free
# On Vercel production, set ENABLE_LLM_ANSWER=true so Ask the Shaman can synthesise
# answers via OpenRouter (otherwise graph/excerpts only). Prefer LLM_SMALL_MODEL for
# serverless latency. Do not point LLM_BASE_URL at home Ollama / trycloudflare from Vercel.
# ENABLE_LLM_ANSWER=true
# Cursor-style grounded synthesis (default). Set ANSWER_STYLE=legacy for excerpt-first answers.
# ANSWER_STYLE=cursor
# Satnav multi-route search (default). Set SEARCH_ROUTE_MODE=legacy for wiki→graph→RAG cascade.
# SEARCH_ROUTE_MODE=satnav
# SEARCH_ROUTE_TIMEOUT_MS=6000
# SEARCH_ROUTE_LEXICAL=1   # optional: also fan out Postgres lexical per route (local only)
# SATNAV_LLM_ADVISOR=1     # LLM picks satnav routes (default on when LLM configured)
# SATNAV_LLM_EACH_STAGE=1  # LLM at every satnav stage: classify, plan, rerank, arbitrate, synthesize
# SATNAV_TRAINING_LOG=1    # append JSONL traces to reports/satnav-training/routes.jsonl
# PREFER_GROUNDED_SYNTHESIS=true
# LLM_TIMEOUT_MS=12000
# Optional: OPENROUTER_API_KEY (alias), OPENROUTER_HTTP_REFERER, OPENROUTER_APP_TITLE
# IMPORTANT: LLM_EMBED_DIM must match the dimension of LLM_EMBED_MODEL and the
# vector(N) column in prisma/migrations/.../migration.sql. To switch dims you
# must edit that migration (or write a new one) and re-run db:migrate:dev.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
# Optional alias for chat model (overrides LLM_CHAT_MODEL when set).
# LLM_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small
LLM_EMBED_DIM=1536

# Optional: dedicated OpenAI-compatible embedding endpoint (otherwise embeddings use LLM_*).
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# --- Unified legal search feature flags (directory + matcher) ---
# V1 directory search backend (auto unless overridden):
#   production / Vercel preview → postgres (Neon FTS on sra_organisations)
# --- Directory search backend ---
# Auto-selects Typesense when TYPESENSE_HOST + TYPESENSE_API_KEY are set (local and Vercel).
# Without Typesense, production/preview uses Postgres FTS on sra_organisations.
#   local dev → typesense when configured (ENABLE_TYPESENSE_UNIFIED=true)
#   production → typesense when TYPESENSE_* vars set on Vercel
# DIRECTORY_SEARCH_BACKEND=postgres
# DIRECTORY_SEARCH_BACKEND=typesense
# ENABLE_TYPESENSE_UNIFIED=true
# TYPESENSE_HOST=search.legalshaman.com
# TYPESENSE_PROTOCOL=https
# TYPESENSE_PORT=443
# TYPESENSE_API_KEY=
# ENABLE_UNIFIED_DIRECTORY=false
# ENABLE_LLM_SEARCH=true
# ENABLE_VECTOR_SEARCH=true
# ENABLE_MEILISEARCH=true
# ENABLE_TYPESENSE=true
# ENABLE_SEARCH_DEBUG=false  # Also on when NODE_ENV=development (debug panel + per-result diagnostics)
# SEARCH_EVENT_SALT=change-me-in-production
# USER_SESSION_SECRET=change-me-in-production   # Signs public user session cookies (bookmarks + search gate)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=              # Cloudflare Turnstile site key (signup/login CAPTCHA)
# TURNSTILE_SECRET_KEY=                        # Cloudflare Turnstile secret key (server verification)
# Search auth gate is OFF by default (temporary). Re-enable with:
# REQUIRE_SEARCH_AUTH=true
# NEXT_PUBLIC_REQUIRE_SEARCH_AUTH=true

# --- Coherence auth + quota (enable before public launch) ---
# REQUIRE_COHERENCE_AUTH=true
# NEXT_PUBLIC_REQUIRE_COHERENCE_AUTH=true
# COHERENCE_FREE_DAILY_LIMIT=20
# COHERENCE_NEW_USER_DAILY_LIMIT=10
# COHERENCE_PAID_DAILY_LIMIT=200
# COHERENCE_PER_MINUTE_LIMIT=3
# COHERENCE_SKIP_EMAIL_VERIFY=1          # dev only when RESEND not configured
# SEARCH_SIGNALS_LOOKBACK_DAYS=30
# SEARCH_SIGNALS_MIN_IMPRESSIONS=3
# ENABLE_TYPESENSE_UNIFIED=true   # Primary /search engine: legal_entities collection
# ENABLE_MAP_SEARCH=true
# ENABLE_GEOCODING=true
# ENABLE_GEOCODING_RUNTIME=false
# ENABLE_RESULT_CLUSTERING=true
# ENABLE_OPEN_RERANKER=false          # Cross-encoder rerank (BGE / Qwen via HF inference)
# OPEN_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# OPEN_RERANKER_LOCAL=false           # Local rerank endpoint disabled by default
# OPEN_RERANKER_LOCAL_URL=http://127.0.0.1:8080/rerank
# HUGGINGFACE_API_KEY=                # Or HF_TOKEN — required for hosted inference
# OPEN_RERANKER_INFERENCE_URL=        # Optional override (defaults to HF models endpoint)
# OPEN_RERANKER_RETRIEVAL_LIMIT=100
# After DB + Typesense are up: npm run search:index:all

# --- Admin token for POST /api/lawyers/embed ---
# Any random string; required for the re-embed admin route.
ADMIN_TOKEN=

# --- Admin area (/admin/*, /api/admin/* except session) ---
# Shared secret: required in production. Scripts and curl use header `x-admin-secret`.
# Browser UI: sign in at /admin/login (sets httpOnly cookie). In development, if unset,
# admin routes stay open and the UI shows a warning banner.
ADMIN_SECRET=
# Base URL when calling admin APIs from CLI (npm run admin:api). Dev server must be running.
# ADMIN_API_BASE_URL=http://localhost:3000

# --- Transactional email (Resend) ---
# Used for listing submissions, guided triage result summaries, and Trustpilot AFS (BCC).
# Verify your domain in Resend before production (do not use noreply@resend.dev).
# RESEND_API_KEY=re_...
# EMAIL_FROM=Legal Shaman <noreply@legalshaman.com>
# TRUSTPILOT_AFS_BCC=legalshaman.com+900f658f6c@invite.trustpilot.com
# ENABLE_TRIAGE_FEEDBACK_EMAIL=true

# --- Provider crawler (compliant enrichment) ---
# Set to 1 in CI/eval to skip outbound fetches. Default in providers:crawl scripts.
# PROVIDER_CRAWL_SKIP_FETCH=1
# PROVIDER_CRAWL_MIN_INTERVAL_MS=1000
# Trustpilot Business API (optional; HTML scraping is disabled)
# TRUSTPILOT_API_KEY=
# TRUSTPILOT_BUSINESS_UNIT_ID=

# =============================================================================
# UK legal knowledge search (POST /api/legal-search, knowledge compiler + chunk fallback)
# =============================================================================
# Backfill graph: npm run knowledge:backfill-areas
# Integrate sources: npm run knowledge:integrate -- --file=path/to/source.md
# Eval: npm run legal-search:eval
# Docs: docs/legal-knowledge-search.md
# KNOWLEDGE_GRAPH_MODE=primary   # primary | shadow | off — graph assembly vs RAG fallback
# ENABLE_LLM_LEGAL_CLASSIFICATION=true   # hybrid OpenRouter classifier when rules are weak
# LEGAL_CLASSIFY_LLM_THRESHOLD=0.14      # rule matchStrength below this triggers LLM
# KNOWLEDGE_GRAPH_SKIP_DB=1      # Skip Postgres concept graph (wiki-index only)
# Reuses LLM_API_KEY / LLM_EMBED_MODEL for concept + chunk embeddings.

# =============================================================================
# SRA Data Share register integration (REQUIRED for SRA-verified results
# and the legacy /search org directory)
# =============================================================================
# `npm run sra:sync` now does all three jobs in one pass:
#   1) Upserts every SRA org into the `sra_organisations` Postgres table
#      AND a matching `firms` row keyed on sraId.
#   2) Indexes orgs into Meilisearch (powers the legacy /search page).
#   3) When LLM_API_KEY is set, embeds each org so they become matchable
#      candidates in /find-a-lawyer alongside curated lawyers.
# After sync, `npm run sra:link-firms` runs the firm <-> SRA name matcher
# for any pre-seeded Firm rows that didn't get an sraId during sync.
# Partial proof run: npm run sra:sync -- --limit=1000 --skip-embeddings
# Resume full sync: npm run sra:sync -- --resume --checkpoint --skip-embeddings
# Manual offset: npm run sra:sync -- --offset=5000 --limit=1000 --checkpoint

# --- SRA Data Share APIM key ---
# Subscribe: https://sra-prod-apim.developer.azure-api.net
# Never put a real key in this file — use `.env.local` (gitignored).
SRA_APIM_SUBSCRIPTION_KEY=

# Max upsert failures allowed on a full nightly sync before aborting purge/index (default: max(10, 0.1% of rows))
# SRA_SYNC_MAX_FAILURES=10

# --- Meilisearch (REQUIRED for `npm run sra:sync`; powers legacy /search) ---
# Spin up locally:
#   docker run -d --name meili -p 7700:7700 \
#     -e MEILI_MASTER_KEY=dev_master_key getmeili/meilisearch:v1.11
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=dev_master_key

# --- Typesense (unified legal_entities index + legacy listings collection) ---
# Start locally (Podman/Docker):
#   docker run -d --name signpost-typesense -p 8108:8108 -v signpost-typesense-data:/data \
#     typesense/typesense:27.1 --data-dir /data --api-key=xyz --enable-cors
# Index all sources: cd web && npm run search:index
# Verify: npm run search:index:verify && npm run search:smoke
# Health: GET /api/search/status
# TYPESENSE_HOST=localhost
# TYPESENSE_API_KEY=xyz
# TYPESENSE_PROTOCOL=http   # required for local/docker; auto-detected for localhost
# TYPESENSE_PORT=8108
# DATABASE_CONNECT_TIMEOUT_MS=30000
# Small batches for hosted Typesense (avoids OUT_OF_MEMORY on bulk import)
# TYPESENSE_IMPORT_BATCH_SIZE=100
# TYPESENSE_IMPORT_PAUSE_MS=250
# SRA_INDEX_SKIP_GEO=1

# =============================================================================
# Hybrid home hosting (Vercel + Fedora Typesense/Ollama via Cloudflare Tunnel)
# Docs: docs/ops/hybrid-home-hosting.md | Rollback: docs/ops/partner-hosted-setup.md
# =============================================================================
# Phase 1 — directory search on home Typesense (tunnel hostname reachable from Vercel):
# DIRECTORY_SEARCH_BACKEND=typesense
# ENABLE_TYPESENSE=true
# ENABLE_TYPESENSE_UNIFIED=true
# TYPESENSE_HOST=search.legalshaman.com
# TYPESENSE_PROTOCOL=https
# TYPESENSE_PORT=443
# TYPESENSE_API_KEY=                    # same key as infra/home/podman-typesense.sh
#
# Phase 2 — skip OpenRouter chat on every directory search (rule-based parse):
# ENABLE_LLM_SEARCH=false
#
# Phase 3 — Ollama chat for guidance; keep OpenRouter for 1536-dim embeddings:
# LLM_BASE_URL=https://llm.legalshaman.com/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=sk-or-...
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_EMBED_DIM=1536                    # must match legal_chunks vector column
#
# Local re-index against Podman Typesense (before tunnel/Vercel switch):
# TYPESENSE_HOST=localhost
# TYPESENSE_PROTOCOL=http
# TYPESENSE_PORT=8108

# Optional: override GetAll URL (default is official APIM endpoint)
# SRA_ORGANISATIONS_URL=

# --- Serper (Google search API) — identity recovery, Yell enrichment, website discovery ---
# Get a key at https://serper.dev — set in `.env.local` only, never commit.
# SERPER_API_KEY=your_serper_key_here
# SEARCH_PROVIDER_DELAY_MS=1200

# Optional: semantic search on curated listings
# HF_TOKEN=

# =============================================================================
# Reddit search (npm run reddit:search — r/LegalAdviceUK agentic retrieval)
# =============================================================================
# LLM planner/scorer reuses LLM_API_KEY + LLM_BASE_URL above (OpenRouter works).
# Optional override for Reddit search only (defaults to LLM_SMALL_MODEL / LLM_MODEL):
# REDDIT_SEARCH_MODEL=qwen/qwen3-8b
# Reddit / OSLAW on legalshaman.com
# Live search uses Reddit RSS by default — no API app required.
# Optional: script app at https://www.reddit.com/prefs/apps for OAuth (scores + comments in API responses)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=LegalShaman/1.0 (by /u/yourusername; OSLAW live search)
#
# Devvit app (OSLAW on Reddit — separate from website API; uses Reddit platform auth)
# NEXT_PUBLIC_OSLAW_REDDIT_APP_URL=https://www.reddit.com/r/legalshaman_dev/?playtest=legalshaman

# ---------------------------------------------------------------------------
# Coherence intake (local Ask the Shaman only — never on Vercel unless V2 cutover)
# ---------------------------------------------------------------------------
# Local dev: ENABLE_COHERENCE_ASK=1 mounts Coherence on /ask-the-shaman.
# Escape hatches: ?classic=1 (classic Ask), ?guided=1 (solicitor matching wizard).
# Uses LLM_API_KEY / OPENROUTER_API_KEY + LLM_SMALL_MODEL and DATA_DATABASE_URL for SRA.
# ENABLE_COHERENCE_ASK=1
#
# --- Staged V1 → V2 cutover (see docs/ops/COHERENCE_CUTOVER.md) ---
# Rollback instantly: COHERENCE_MODE=legacy
#
# Vercel production shell (classic Ask stays default until you opt in):
# ENABLE_COHERENCE_V2=true
# COHERENCE_MODE=legacy|shadow|v2
# COHERENCE_V2_ADMIN_ONLY=true          # phase 1 — admin/test accounts only
# COHERENCE_V2_PERCENT=10               # phase 2 — logged-in rollout bucket
# COHERENCE_ADMIN_EMAILS=you@example.com
# NEXT_PUBLIC_COHERENCE_QUERY_GATEWAY=true   # browser calls POST /api/coherence/query
# NEXT_PUBLIC_REQUIRE_COHERENCE_AUTH=true
# REQUIRE_COHERENCE_AUTH=true
#
# Vercel → home backend (Cloudflare quick/named tunnel — no port forwarding):
# COHERENCE_BACKEND_ORIGIN=https://xxxx.trycloudflare.com
# COHERENCE_INTERNAL_SECRET=long-random-shared-secret
# COHERENCE_BACKEND_TIMEOUT_MS=170000
#
# Local home server (same secret as Vercel):
# ENABLE_COHERENCE_ASK=1
# COHERENCE_INTERNAL_SECRET=long-random-shared-secret
#
# Optional overrides:
# OPENROUTER_MODEL=
# LEGAL_SHAMAN_WIKI_INDEX=./data/wiki-index.json
# LEGAL_SHAMAN_ROOT=/home/pravda/Projects/legal_shaman
