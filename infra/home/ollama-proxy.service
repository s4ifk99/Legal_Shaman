[Unit]
Description=Ollama reverse proxy for Cloudflare Tunnel (Host header rewrite)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/Legal Shaman/Signpost/infra/home
ExecStart=/usr/bin/python3 ollama-proxy.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
